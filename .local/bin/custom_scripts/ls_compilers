# Portable 3-second timeout to prevent tools from hanging on network checks or daemons
run_with_timeout() {
    if command -v timeout >/dev/null 2>&1; then
        timeout 3s "$@"
    elif command -v gtimeout >/dev/null 2>&1; then
        gtimeout 3s "$@"
    elif command -v perl >/dev/null 2>&1; then
        perl -e 'alarm 3; exec @ARGV' -- "$@"
    else
        "$@"
    fi
}
# Function to check and print an array of tools
check_tool_array() {
    local -a tools=("$@")
    local found=0
    local missing=0
    for entry in "${tools[@]}"; do
        IFS='|' read -r label cmd verflag <<< "$entry"
        raw=$(whence -ap "$cmd" 2>/dev/null)
        if [[ -z "$raw" ]]; then
            matches=()
        else
            matches=("${(@f)raw}")
        fi
        if (( ${#matches[@]} > 0 )); then
            found=$((found + 1))
            plural=""
            (( ${#matches[@]} > 1 )) && plural="s"
            echo "${GREEN}[OK]${RESET} ${label} ${DIM}(${#matches[@]} installation${plural})${RESET}"
            for bin_path in "${matches[@]}"; do
                # "< /dev/null" prevents interactive setup prompts; timeout prevents daemon/network hangs
                if [[ "$cmd" == "perl" ]]; then
                    ver=$(run_with_timeout "$bin_path" "${(z)verflag}" < /dev/null 2>&1 | grep -m1 -i "This is perl")
                elif [[ "$cmd" == "cpan" ]]; then
                    ver=$(run_with_timeout "$bin_path" "${(z)verflag}" < /dev/null 2>&1 | grep -m1 -i "cpan script version")
                else
                    ver=$(run_with_timeout "$bin_path" "${(z)verflag}" < /dev/null 2>&1 | head -n1)
                fi
                echo "       ${DIM}${bin_path}${RESET}"
                echo "       ${DIM}${ver:-${YELLOW}(version check timed out or silent)${DIM}}${RESET}"
            done
        else
            missing=$((missing + 1))
            echo "${RED}[--]${RESET} ${label} ${DIM}not found${RESET}"
        fi
    done
    echo "${DIM}------------------------------------------------------------${RESET}"
    echo "${BOLD}${found} found, ${missing} missing${RESET}"
    echo
}
